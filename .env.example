BOT_TOKEN=сюда_токен_от_BotFather

# Посты в канал: канал (@username или id вида -100123...) и админы бота (id через запятую)
CHANNEL_ID=@speedupaudioe
ADMIN_IDS=123456789

# Где искать аудио, по порядку (по умолчанию youtube,soundcloud).
# Если YouTube блокирует сервер, поставь soundcloud,youtube
# SEARCH_SOURCES=youtube,soundcloud

# Необязательно: путь к cookies.txt для yt-dlp, если YouTube блокирует скачивание
# (на Render: загрузи файл в Secret Files, тогда путь будет /etc/secrets/cookies.txt)
# COOKIES_FILE=/etc/secrets/cookies.txt

# Mini App: на Render адрес берётся автоматически (нужен Web Service).
# Если хостишь в другом месте, укажи https-адрес страницы вручную:
# WEBAPP_URL=https://твой-домен/app
